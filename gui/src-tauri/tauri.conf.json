{
  "$schema": "https://raw.githubusercontent.com/nicholascross/tauri-v2/refs/heads/main/crates/tauri-utils/schema.json",
  "productName": "dumbWASD",
  "version": "0.1.0",
  "identifier": "com.dumbwasd.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "dumbWASD",
        "width": 1100,
        "height": 700,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
